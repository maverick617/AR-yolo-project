  rules:
  - detectionLabel: phone
    prefab: {fileID: 6591014151576691776, guid: 6d1afbaddff8dd941bcd93bc4015be48, type: 3}
    spawnScale: {x: 0.07, y: 0.15, z: 0.008}
    verticalOffsetMeters: 0
    raycastAnchorInBoundingBox: {x: 0.5, y: 0.85}
    rotationOffsetEuler: {x: 0, y: 0, z: 0}
    scaleCalibrationMultiplier: 1
    minConfidence: 0.45
    trackingMinConfidence: 0.3
    confirmationFrames: 1
    positionSmoothing: 0.18
    estimateScaleFromBoundingBox: 1
    scaleBoundingBoxAxis: 2
    estimatedHeightMultiplier: 0.9
    estimatedWidthMultiplier: 0.9
    scaleMultiplierRange: {x: 0.25, y: 8}
    useAprilTagPose: 1
    aprilTagId: 4
    aprilTagTrackedImageName:
    aprilTagToObjectOffsetMeters: {x: 0, y: 0, z: 0.004}
    aprilTagToObjectRotationEuler: {x: 0, y: 0, z: 0}
    aprilTagMaxPoseAgeSeconds: 0.35
    additionalAprilTagMounts:
    - tagId: 5
      trackedImageName:
      tagToObjectRotationEuler: {x: 0, y: 180, z: 0}
      overrideCupCenterOffset: 0
      tagToCupCenterDirection: {x: 0, y: 0, z: 1}
      useCupHeightForCenterDistance: 0
      tagMountStandoffMeters: 0
    enableAutomaticCupRegistration: 0
    cupRegistrationSamples: 3
    minimumRegistrationViewAngleDegrees: 0
    minimumRegistrationMeasurementConfidence: 0.2
    useStandardCupTagMount: 0
    tagToCupCenterDirection: {x: 0, y: 0, z: 1}
    tagMountStandoffMeters: 0
    fitMeasuredWidthAndHeight: 0
    maximumNonUniformScaleRatio: 1.8
    tagLostVisualFallbackSeconds: 0.8
